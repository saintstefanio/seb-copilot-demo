#!/usr/bin/env bash
# Jira Cloud CLI using only Bash and curl.
set -euo pipefail

usage() {
  echo "usage: ./jira <get|search|comment|update|transitions|transition|selfcheck> ..." >&2
  exit "${1:-0}"
}

json_string() {
  local text=$1
  local controls=${text//$'\n'/}
  controls=${controls//$'\r'/}
  controls=${controls//$'\t'/}
  if [[ $controls =~ [[:cntrl:]] ]]; then
    echo "comments cannot contain control characters other than tab or newline" >&2
    return 1
  fi
  text=${text//\\/\\\\}
  text=${text//\"/\\\"}
  text=${text//$'\n'/\\n}
  text=${text//$'\r'/\\r}
  text=${text//$'\t'/\\t}
  printf '%s' "$text"
}

jira_curl() {
  curl -fsS "${jira_auth_args[@]}" -H "Accept: application/json" "$@"
}

# Reads JIRA_* keys from a .env file without executing it. Existing environment
# variables win, so an explicit export always overrides the file.
load_env_file() {
  local file=$1 line key value
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    case $line in ''|'#'*) continue ;; esac
    line=${line#export }
    key=${line%%=*}
    value=${line#*=}
    [ "$key" = "$line" ] && continue
    key=${key//[[:space:]]/}
    case $key in JIRA_BASE_URL|JIRA_EMAIL|JIRA_API_TOKEN|JIRA_PERSONAL_ACCESS_TOKEN) ;; *) continue ;; esac
    value=${value#"${value%%[![:space:]]*}"}
    value=${value%"${value##*[![:space:]]}"}
    case $value in
      \"*\") value=${value#\"}; value=${value%\"} ;;
      \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    [ -n "${!key:-}" ] || export "$key=$value"
  done < "$file"
}

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
for env_file in "$script_dir/.env" "$script_dir/../.env" "$PWD/.env"; do
  load_env_file "$env_file"
done

command=${1:-}
case "$command" in
  selfcheck)
    [ "$(json_string $'a"b\\c\n')" = 'a\"b\\c\n' ] || exit 1
    echo "selfcheck ok"
    exit 0
    ;;
  -h|--help|'') usage ;;
esac

: "${JIRA_BASE_URL:?Set JIRA_BASE_URL.}"

# Auth mode is picked automatically: a personal access token means Jira
# Server/Data Center (Bearer + REST v2); otherwise Jira Cloud (Basic + REST v3).
if [ -n "${JIRA_PERSONAL_ACCESS_TOKEN:-}" ]; then
  jira_auth_args=(-H "Authorization: Bearer ${JIRA_PERSONAL_ACCESS_TOKEN}")
  api=2
else
  : "${JIRA_EMAIL:?Set JIRA_EMAIL, or set JIRA_PERSONAL_ACCESS_TOKEN for Jira Server/Data Center.}"
  : "${JIRA_API_TOKEN:?Set JIRA_API_TOKEN, or set JIRA_PERSONAL_ACCESS_TOKEN for Jira Server/Data Center.}"
  jira_auth_args=(-u "${JIRA_EMAIL}:${JIRA_API_TOKEN}")
  api=3
fi
base_url=${JIRA_BASE_URL%/}

case "$command" in
  get)
    [ "$#" -eq 2 ] || usage 1
    jira_curl "${base_url}/rest/api/${api}/issue/$2?fields=summary,status,assignee,description"
    ;;
  search)
    [ "$#" -eq 2 ] || usage 1
    if [ "$api" = 2 ]; then
      jira_curl --get "${base_url}/rest/api/2/search" \
        --data-urlencode "jql=$2" \
        --data-urlencode "maxResults=20" \
        --data-urlencode "fields=summary,status"
    else
      jira_curl --get "${base_url}/rest/api/3/search/jql" \
        --data-urlencode "jql=$2" \
        --data-urlencode "maxResults=20" \
        --data-urlencode "fields=summary" \
        --data-urlencode "fields=status"
    fi
    ;;
  comment)
    [ "$#" -eq 3 ] || usage 1
    text=$(json_string "$3")
    if [ "$api" = 2 ]; then
      body='{"body":"'"$text"'"}'
    else
      body='{"body":{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"'"$text"'"}]}]}}'
    fi
    jira_curl -X POST -H "Content-Type: application/json" --data "$body" \
      "${base_url}/rest/api/${api}/issue/$2/comment"
    ;;
  update)
    [ "$#" -eq 3 ] || usage 1
    jira_curl -X PUT -H "Content-Type: application/json" --data "{\"fields\":$3}" \
      "${base_url}/rest/api/${api}/issue/$2"
    echo '{"ok":true}'
    ;;
  transitions)
    [ "$#" -eq 2 ] || usage 1
    jira_curl "${base_url}/rest/api/${api}/issue/$2/transitions"
    ;;
  transition)
    [ "$#" -eq 3 ] || usage 1
    [[ $3 =~ ^[0-9]+$ ]] || { echo "transition id must be numeric" >&2; exit 1; }
    jira_curl -X POST -H "Content-Type: application/json" --data "{\"transition\":{\"id\":\"$3\"}}" \
      "${base_url}/rest/api/${api}/issue/$2/transitions"
    echo '{"ok":true}'
    ;;
  *) echo "unknown command: $command" >&2; usage 1 ;;
esac
