#!/usr/bin/env bash
# Jira Cloud CLI using only Bash and curl.
set -euo pipefail

usage() {
  echo "usage: ./jira <get|search|comment|update|transitions|transition|selfcheck> ..." >&2
  exit "${1:-0}"
}

json_string() {
  local text=$1
  local controls=${text//$'\n'/}
  controls=${controls//$'\r'/}
  controls=${controls//$'\t'/}
  if [[ $controls =~ [[:cntrl:]] ]]; then
    echo "comments cannot contain control characters other than tab or newline" >&2
    return 1
  fi
  text=${text//\\/\\\\}
  text=${text//\"/\\\"}
  text=${text//$'\n'/\\n}
  text=${text//$'\r'/\\r}
  text=${text//$'\t'/\\t}
  printf '%s' "$text"
}

jira_curl() {
  curl -fsS -u "${JIRA_EMAIL}:${JIRA_API_TOKEN}" -H "Accept: application/json" "$@"
}

command=${1:-}
case "$command" in
  selfcheck)
    [ "$(json_string $'a"b\\c\n')" = 'a\"b\\c\n' ] || exit 1
    echo "selfcheck ok"
    exit 0
    ;;
  -h|--help|'') usage ;;
esac

: "${JIRA_BASE_URL:?Set JIRA_BASE_URL.}"
: "${JIRA_EMAIL:?Set JIRA_EMAIL.}"
: "${JIRA_API_TOKEN:?Set JIRA_API_TOKEN.}"
base_url=${JIRA_BASE_URL%/}

case "$command" in
  get)
    [ "$#" -eq 2 ] || usage 1
    jira_curl "${base_url}/rest/api/3/issue/$2?fields=summary,status,assignee,description"
    ;;
  search)
    [ "$#" -eq 2 ] || usage 1
    jira_curl --get "${base_url}/rest/api/3/search/jql" \
      --data-urlencode "jql=$2" \
      --data-urlencode "maxResults=20" \
      --data-urlencode "fields=summary" \
      --data-urlencode "fields=status"
    ;;
  comment)
    [ "$#" -eq 3 ] || usage 1
    text=$(json_string "$3")
    body='{"body":{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"'"$text"'"}]}]}}'
    jira_curl -X POST -H "Content-Type: application/json" --data "$body" \
      "${base_url}/rest/api/3/issue/$2/comment"
    ;;
  update)
    [ "$#" -eq 3 ] || usage 1
    jira_curl -X PUT -H "Content-Type: application/json" --data "{\"fields\":$3}" \
      "${base_url}/rest/api/3/issue/$2"
    echo '{"ok":true}'
    ;;
  transitions)
    [ "$#" -eq 2 ] || usage 1
    jira_curl "${base_url}/rest/api/3/issue/$2/transitions"
    ;;
  transition)
    [ "$#" -eq 3 ] || usage 1
    [[ $3 =~ ^[0-9]+$ ]] || { echo "transition id must be numeric" >&2; exit 1; }
    jira_curl -X POST -H "Content-Type: application/json" --data "{\"transition\":{\"id\":\"$3\"}}" \
      "${base_url}/rest/api/3/issue/$2/transitions"
    echo '{"ok":true}'
    ;;
  *) echo "unknown command: $command" >&2; usage 1 ;;
esac
